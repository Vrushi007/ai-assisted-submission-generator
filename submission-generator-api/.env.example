# Database Configuration
DATABASE_URL=postgresql://postgres:Welcome%401@localhost:5432/regulatory-database

# Application Configuration
APP_NAME="AI-Assisted Regulatory Submission Builder"
APP_VERSION="1.0.0"
DEBUG=False
SECRET_KEY=your-secret-key-here

# Security
# Comma-separated list of allowed web origins
CORS_ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000
# Keep disabled unless you explicitly want direct static file access
SERVE_UPLOADS_PUBLIC=false
# Optional API key to protect all /api/* routers (except /api/health)
INTERNAL_API_KEY=

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# IMDRF Templates
TEMPLATES_DIR=./templates/imdrf

# Logging
LOG_LEVEL=INFO

# AI Logging Controls
# Keep false in production to avoid storing document content in logs
AI_LOG_INCLUDE_CONTENT=false
AI_LOG_MAX_CONTENT_CHARS=500

# AI Configuration
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-105b